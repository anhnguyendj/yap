# KHONG BAT BUOC. Nguoi dung thuong dan key trong Settings cua Yap la xong.
# File nay cho dev / ghi de: chep thanh .env roi dien gia tri. Key trong .env
# THANG key trong Settings (Settings se bao do). File .env KHONG duoc commit.

# Groq - nha cung cap mac dinh. Lay o: https://console.groq.com/keys
# -> Create API key. Key bat dau bang gsk_
GROQ_API_KEY=

# OpenAI - chi can neu doi provider sang "openai" trong Settings.
# Lay o: https://platform.openai.com/api-keys . Key bat dau bang sk-
OPENAI_API_KEY=
